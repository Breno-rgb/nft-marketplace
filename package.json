{
  "name": "nft-marketplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint src e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:atualizar-visual": "playwright test visual --update-snapshots",
    "test:e2e:producao": "playwright test --config playwright.producao.config.ts --grep-invert visual",
    "lighthouse": "npm run build && node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource/space-mono": "^5.3.0",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "msw": "^3.0.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lighthouse": "^13.6.0",
    "oxlint": "^1.90.0",
    "shadcn": "^4.23.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
